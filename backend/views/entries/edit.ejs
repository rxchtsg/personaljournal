<%- include('../layout', { title: 'Edit ' + entry.title, body: `
  <h1>Edit Entry</h1>
  <form action="/entries/${entry.id}/update" method="post">
    <p><label>Title</label><br><input name="title" value="${entry.title}" required></p>
    <p><label>Body</label><br><textarea name="body" rows="6" required>${entry.body}</textarea></p>
    <button type="submit">Update</button>
  </form>
  <p><a href="/entries/${entry.id}">Cancel</a></p>
` }) %>
