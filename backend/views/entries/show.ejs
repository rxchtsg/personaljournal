<%- include('../layout', { title: entry.title, body: `
  <h1>${entry.title}</h1>
  <p>${entry.body}</p>
  <p><small style="color:#777">${entry.created_at}</small></p>
  <p>
    <a href="/entries/${entry.id}/edit">edit</a>
    <form action="/entries/${entry.id}/delete" method="post" style="display:inline">
      <button type="submit">delete</button>
    </form>
  </p>
  <p><a href="/entries">Back</a></p>
` }) %>
